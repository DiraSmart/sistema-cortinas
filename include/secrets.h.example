/*
 * ==============================================
 * CONFIGURACIÓN POR INSTALACIÓN - PLANTILLA
 * ==============================================
 *
 * Copia este archivo a include/secrets.h y ajusta los valores del cliente.
 *
 *     cp include/secrets.h.example include/secrets.h
 *
 * include/secrets.h está en .gitignore: NUNCA se commitea, así que las
 * credenciales de cada cliente no acaban en el repositorio.
 *
 * Todo lo que definas aquí tiene prioridad sobre los valores genéricos de
 * config.h. Lo que no definas, usa el genérico. Borra las líneas que no
 * necesites.
 */

#ifndef SECRETS_H
#define SECRETS_H

// ----------------------------------------------
// Marca de la build (aparece en la versión y en Home Assistant)
// Ej: "-vicsons" produce la versión "1.2.7-vicsons"
// ----------------------------------------------
#define FIRMWARE_VARIANT        "-cliente"

// ----------------------------------------------
// WiFi del cliente
// ----------------------------------------------
#define DEFAULT_WIFI_SSID       "RedDelCliente"
#define DEFAULT_WIFI_PASSWORD   "claveDelCliente"

// Red de respaldo: si la principal no aparece en el escaneo, prueba esta.
// Útil para dejar la red propia de soporte como alternativa.
#define DEFAULT_WIFI_SSID2      "dirasmart"
#define DEFAULT_WIFI_PASSWORD2  "claveDeSoporte"

// ----------------------------------------------
// Access Point de respaldo
// Se levanta si no hay WiFi por 2 minutos. Desde él se configura el equipo
// en http://192.168.4.1
// ----------------------------------------------
#define AP_SSID                 "RF_Controller"
#define AP_PASSWORD             "12345678"

// ----------------------------------------------
// Autenticación de la interfaz web
// ----------------------------------------------
#define WEB_AUTH_USER           "admin"
#define WEB_AUTH_PASSWORD       "claveWeb"

// ----------------------------------------------
// Broker MQTT (Home Assistant)
// Si se deja sin definir, se configura desde la interfaz web.
// ----------------------------------------------
#define MQTT_DEFAULT_SERVER     "192.168.1.10"
#define MQTT_DEFAULT_PORT       1883
#define MQTT_DEFAULT_USER       "mqtt-user"
#define MQTT_DEFAULT_PASSWORD   "mqtt-password"

#endif // SECRETS_H
